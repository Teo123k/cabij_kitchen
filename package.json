    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test:contract": "node src/core/__tests__/canonicalRecipe.test.js",
        "test:operations": "node --test src/operations/__tests__/*.test.js",
